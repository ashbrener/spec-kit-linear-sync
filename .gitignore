# Secrets — never commit
.env
.env.local
.env.*.local
*.pem
*.key

# Operator-local identity (spec 004 — config / identity split). The
# resolved `linear-config.yml` is COMMITTED — it holds only the shareable
# binding (team/project UUIDs, workflow-state + label maps, toggles), no
# personal data. The operator's identity (user_id, name, email) lives in
# a gitignored operator-local file matched by this glob, so a public repo
# never leaks the operator's Linear identity. `speckit.linear.install`
# scaffolds the file and guarantees this entry (FR-002, FR-003, FR-004).
.specify/extensions/linear/*.local.yml

# OS detritus
.DS_Store
Thumbs.db

# Editor / tooling
.vscode/
.idea/
*.swp
*.swo

# Claude Code local-only settings (skills under .claude/skills/ are tracked)
.claude/settings.local.json
# Local operator dogfood slash commands — hardcode an absolute path + assume a
# real .env; convenience only, not a product surface (the product path is the
# extension's generated consumer skills). Keep local.
.claude/commands/
# Agent worktrees — ephemeral, isolated checkouts; never committed
.claude/worktrees/
# Local MCP server wiring — machine-specific
.mcp.json

# Python build artefacts (in case the bridge ships a Python implementation)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node build artefacts (in case the bridge ships a Node implementation)
node_modules/
dist/
build/
*.log
.npm/
.yarn/

# Spec-kit ephemera
.specify/cache/
